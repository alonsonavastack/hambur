{
  "name": "alo-monorepo",
  "private": true,
  "packageManager": "npm@11.5.2",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/alo",
    "build": "npm run build -w apps/alo",
    "test": "npm run test:core && npm run test -w apps/alo -- --watch=false",
    "test:core": "vitest run --root libs/alo-core"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.5"
  }
}
